[Unit]
Description=Logistics dimension estimation API (3-view)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/model
EnvironmentFile=/etc/dimension-api.env
ExecStart=/home/ec2-user/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
