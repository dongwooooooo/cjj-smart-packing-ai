[Unit]
Description=Logistics dimension estimation API (3-view)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/model
EnvironmentFile=/etc/dimension-api.env
ExecStart=/home/ubuntu/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
